# --- Telegram (required) ---------------------------------------------------
# Create an app at https://my.telegram.org/apps and copy api_id / api_hash.
TELEGRAM_APP_ID=
TELEGRAM_APP_HASH=

# --- AI (optional, any OpenAI-compatible Chat Completions API) -------------
# OpenAI:      AI_BASE_URL=https://api.openai.com/v1      AI_MODEL=gpt-4.1-mini
# OpenRouter:  AI_BASE_URL=https://openrouter.ai/api/v1   AI_MODEL=<provider/model>
# Groq:        AI_BASE_URL=https://api.groq.com/openai/v1 AI_MODEL=<model>
# Ollama:      AI_BASE_URL=http://localhost:11434/v1      AI_MODEL=llama3.1  (AI_API_KEY can be empty)
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
# Set to false if your server rejects response_format={"type":"json_object"}.
AI_JSON_MODE=true
# Chats per request and parallel requests. Lower these for small local models
# or rate-limited free tiers (e.g. AI_CONCURRENCY=1 on Groq free).
AI_BATCH_SIZE=25
AI_CONCURRENCY=3
# Optional cap on max_tokens per request (0 = automatic). The app also learns
# the limit from "request too large" errors and splits batches to fit.
AI_MAX_TOKENS=0
# Optional reasoning_effort for thinking models. Thinking burns output tokens,
# so turn it down: "none" for Qwen3 on Groq, "minimal"/"low" for OpenAI o-series/GPT-5.
AI_REASONING_EFFORT=

# --- Server ----------------------------------------------------------------
ADDR=127.0.0.1:8080
DATA_DIR=data
