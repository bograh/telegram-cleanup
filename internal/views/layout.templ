package views

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<link rel="stylesheet" href="/static/app.css"/>
			<script src="/static/htmx.min.js"></script>
			<script src="/static/app.js" defer></script>
		</head>
		<body hx-boost="false">
			{ children... }
			<div id="toast" aria-live="polite"></div>
		</body>
	</html>
}

templ Brand() {
	<div class="brand">
		<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M21.4 4.3 2.9 11.4c-1.3.5-1.3 1.2-.2 1.5l4.7 1.5 1.8 5.6c.2.6.4.8.9.8.4 0 .6-.2.9-.4l2.3-2.2 4.7 3.5c.9.5 1.5.2 1.7-.8l3.1-14.6c.3-1.3-.5-1.9-1.4-1.5ZM9 14l8.6-5.4c.4-.3.8-.1.5.2l-7.1 6.4-.3 3.2L9 14Z"></path></svg>
		<span>Telegram Cleanup</span>
	</div>
}

templ Setup(missing []string) {
	@Layout("Setup · Telegram Cleanup") {
		<main class="center">
			<div class="card narrow">
				@Brand()
				<h1>Almost there</h1>
				<p class="muted">The app needs a few settings in <code>.env</code> before it can connect.</p>
				<ul class="missing">
					for _, m := range missing {
						<li><code>{ m }</code></li>
					}
				</ul>
				<ol class="steps">
					<li>Go to <a href="https://my.telegram.org/apps" target="_blank" rel="noopener">my.telegram.org/apps</a>, log in and create an app (any name). Copy the <b>api_id</b> and <b>api_hash</b>.</li>
					<li>Copy <code>.env.example</code> to <code>.env</code> and fill in <code>TELEGRAM_APP_ID</code> and <code>TELEGRAM_APP_HASH</code>.</li>
					<li>Optionally set <code>AI_BASE_URL</code>, <code>AI_API_KEY</code> and <code>AI_MODEL</code> to use any OpenAI-compatible API.</li>
					<li>Restart the server and reload this page.</li>
				</ol>
			</div>
		</main>
	}
}
