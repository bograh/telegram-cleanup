package views

// Login is the state of the login card.
type Login struct {
	Step      string // "phone", "code", "password" or "qr"
	Err       string
	Where     string // where Telegram sent the code
	Next      string // channel "Resend" switches to
	CanResend bool
	Blocked   bool   // Telegram won't send a code; QR is the way in
	QRImage   string // data URI
	Notice    string // e.g. "Code re-sent"
}

templ LoginPage(l Login) {
	@Layout("Connect · Telegram Cleanup") {
		<main class="center">
			<div class="card narrow">
				@Brand()
				@LoginForm(l)
				<p class="fine">
					Your session is stored only on this machine in <code>data/session.json</code>.
					The app talks to Telegram directly from your computer.
				</p>
			</div>
		</main>
	}
}

templ LoginForm(l Login) {
	<div id="login">
		switch l.Step {
			case "code":
				<h1>Enter the code</h1>
				if l.Blocked {
					<p class="callout warn">
						Telegram didn't send a code. It says it sent it { l.Where }.
						Log in with a QR code instead (below), or add a login email in the official app under
						Settings → Privacy and Security → Login Email.
					</p>
				} else {
					<p class="muted">Telegram sent the code <b>{ l.Where }</b>.</p>
				}
				if l.Notice != "" {
					<p class="notice">{ l.Notice }</p>
				}
				<form hx-post="/login/code" hx-target="#login" hx-swap="outerHTML" hx-disabled-elt="find button">
					<label>Login code<input name="code" inputmode="numeric" autocomplete="one-time-code" required autofocus?={ !l.Blocked }/></label>
					@loginError(l.Err)
					<button class="btn primary" type="submit">Verify</button>
				</form>
				<div class="login-alt">
					if l.CanResend {
						<button class="btn small" hx-post="/login/resend" hx-target="#login" hx-swap="outerHTML" hx-disabled-elt="this">
							Resend via { l.Next }
						</button>
					}
					@qrButton()
					<a class="btn ghost small" href="/">Use a different number</a>
				</div>
			case "password":
				<h1>Two-step verification</h1>
				<p class="muted">Your account has a cloud password. Enter it to finish connecting.</p>
				<form hx-post="/login/password" hx-target="#login" hx-swap="outerHTML" hx-disabled-elt="find button">
					<label>Password<input name="password" type="password" autocomplete="current-password" required autofocus/></label>
					@loginError(l.Err)
					<button class="btn primary" type="submit">Unlock</button>
				</form>
			case "qr":
				<h1>Scan with your phone</h1>
				<ol class="steps">
					<li>Open Telegram on your phone.</li>
					<li>Go to <b>Settings → Devices → Link Desktop Device</b>.</li>
					<li>Point your phone at this QR code.</li>
				</ol>
				<div class="qr" hx-post="/login/qr" hx-trigger="every 2s" hx-target="#login" hx-swap="outerHTML">
					if l.QRImage != "" {
						<img src={ templ.SafeURL(l.QRImage) } alt="Telegram login QR code" width="232" height="232"/>
					}
				</div>
				@loginError(l.Err)
				<p class="fine center-text">The code refreshes automatically. This page continues on its own once you approve.</p>
				<div class="login-alt">
					<a class="btn ghost small" href="/">Use phone number instead</a>
				</div>
			default:
				<h1>Connect your Telegram</h1>
				<p class="muted">Log in with your phone number, the same way the Telegram app does.</p>
				<form hx-post="/login/phone" hx-target="#login" hx-swap="outerHTML" hx-disabled-elt="find button">
					<label>Phone number<input name="phone" type="tel" placeholder="+233 20 000 0000" autocomplete="tel" required autofocus/></label>
					@loginError(l.Err)
					<button class="btn primary" type="submit">Send code</button>
				</form>
				<div class="divider"><span>or</span></div>
				<div class="login-alt">
					@qrButton()
				</div>
		}
	</div>
}

templ qrButton() {
	<button class="btn small" hx-post="/login/qr" hx-target="#login" hx-swap="outerHTML" hx-disabled-elt="this">
		Log in with QR code
	</button>
}

templ loginError(msg string) {
	if msg != "" {
		<p class="error">{ msg }</p>
	}
}
